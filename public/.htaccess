<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Si el archivo o carpeta existe físicamente (ej: sitemap.xml, favicon.ico, imágenes), servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Si el archivo NO existe físicamente, redirigir a index.html para que React Router maneje la ruta
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Caché general para CDN por defecto
  Header set Cache-Control "public, s-maxage=604800, max-age=0"

  # Caché de navegador para los assets compilados de Vite (JS, CSS, imágenes en /assets)
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Asegurar que sitemap.xml y robots.txt no queden atrapados en caché agresiva
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>